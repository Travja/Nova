{
	"name": "nova",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"icons": "node scripts/generate-icons.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.mjs",
		"db:studio": "drizzle-kit studio",
		"e2e": "playwright test",
		"db:reset:e2e": "node scripts/reset-e2e-db.mjs",
		"seed:issues": "node scripts/seed-issues.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^9.6.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/coverage-v8": "^5.0.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.0.16",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.2.1",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.6.2"
	},
	"description": "Track your goals as orbits \u2014 a space-themed, installable goal tracker."
}
