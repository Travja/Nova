# Where the SQLite database lives. Relative paths are resolved from the
# project root; the directory is created on first run.
DATABASE_URL=file:./data/nova.db

# SvelteKit's CSRF protection compares this against the request origin, so it
# must match the URL you actually browse to in production.
ORIGIN=http://localhost:3000

# Port the Node server listens on.
PORT=3000

# Logging. `debug` adds healthcheck requests; `LOG_FORMAT=pretty` swaps the
# JSON lines for a readable one-liner while developing.
LOG_LEVEL=info
LOG_FORMAT=json

# Optional. POST unhandled errors to a sink you host yourself; unset means no
# error leaves the machine.
# ERROR_REPORT_URL=https://errors.example.com/hook
# ERROR_REPORT_TOKEN=

# Backups. On by default in production, off while developing; `true` or `false`
# overrides either way. Snapshots are taken with VACUUM INTO, which is safe on a
# live WAL database, and rotate to the newest snapshot of the last N days and M
# weeks. BACKUP_DIR defaults to a `backups` directory beside the database.
# BACKUP_ENABLED=true
# BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Email. Unset means Nova sends no mail and reaches no mail server: password
# reset is then offline, and `pnpm reset:password <email>` prints a reset link
# on the server instead. Any SMTP server will do — your own relay, or a mailbox
# you already have. Port 465 is treated as implicit TLS; anything else must
# support STARTTLS, which is required rather than optional since the reset link
# travels in the message.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=nova@example.com
# SMTP_PASS=
# SMTP_SECURE=            # override the port-465 guess: true or false
# MAIL_FROM=Nova <nova@example.com>

# Development and tests only: write messages to this directory instead of
# sending them. Takes priority over SMTP_HOST, so a machine holding real
# credentials cannot mail a real person by accident.
# MAIL_OUTBOX_DIR=./data/outbox
